APP_NAME=Custosell
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=2.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=custosell
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost:8000,localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-mail-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@example.com
MAIL_FROM_NAME="Custosell"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
FRONTEND_URL=http://localhost:5173

PLATFORM_ADMIN_EMAILS=admin@example.com
PLATFORM_ACTIVITY_WINDOW_DAYS=30

# -----------------------------------------------------------------------
# URA EFRIS
# -----------------------------------------------------------------------
EFRIS_ENABLED=false
EFRIS_COUNTRY=UG
EFRIS_MODE=api
EFRIS_FISCALIZE_POS=true
EFRIS_FISCALIZE_INVOICES=true
EFRIS_OFFLINE_MODE=sync_later
EFRIS_ENVIRONMENT=sandbox
# EFRIS_BASE_URL=https://efristest.ura.go.ug
EFRIS_TIN=
EFRIS_DEVICE_NO=
EFRIS_BRANCH_ID=
EFRIS_API_USERNAME=
EFRIS_API_PASSWORD=
EFRIS_PRIVATE_KEY_PATH=
EFRIS_PUBLIC_KEY_PATH=

# -----------------------------------------------------------------------
# PesaPal
# -----------------------------------------------------------------------
PESAPAL_ENABLED=true
PESAPAL_ENVIRONMENT=sandbox
PESAPAL_BYPASS=true
PESAPAL_SANDBOX_CONSUMER_KEY=your-sandbox-consumer-key
PESAPAL_SANDBOX_CONSUMER_SECRET=your-sandbox-consumer-secret
PESAPAL_PRODUCTION_CONSUMER_KEY=your-production-consumer-key
PESAPAL_PRODUCTION_CONSUMER_SECRET=your-production-consumer-secret
PESAPAL_CALLBACK_URL=http://localhost:8000/api/v1/billing/gateway/pesapal/callback
PESAPAL_IPN_URL=http://localhost:8000/api/v1/billing/gateway/pesapal/ipn
PESAPAL_IPN_ID=your-ipn-id

EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key
EXCHANGE_RATE_BASE_URL=https://v6.exchangerate-api.com/v6

ONBOARDING_TRIAL_DAYS=30

TEST_BUSINESS_EMAIL=testmail
TEST_BUSINESS_PASSWORD=password
